# Copy to .env for LOCAL development; never commit .env.
# Generate a unique key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=REPLACE_WITH_YOUR_RANDOM_SECRET_KEY
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Optional DB_NAME, DB_USER, DB_PASSWORD, DB_HOST or DATABASE_URL
# Optional DEFAULT_ADMIN_PASSWORD (only if deliberately running seed_admin)
